{% extends "common/layout.njk" %}

{% block content %}
  <div class="govuk-grid-row govuk-!-margin-top-6">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Sign in to {{ serviceName }}</h1>

      <p class="govuk-body">
        You need a Defra account to sign in.
      </p>

      <a href="/login/callback" class="govuk-button govuk-button--start">
        Sign in with your Defra account
        <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
        </svg>
      </a>
    </div>
  </div>
{% endblock %}
