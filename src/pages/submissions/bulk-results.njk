{% extends "common/layout.njk" %}

{% set pageTitle = "Bulk triage results" %}
{% set page = "submissions" %}

{% block content %}
  <div class="govuk-width-container govuk-!-margin-top-6">
    <h1 class="govuk-heading-l">Bulk triage results</h1>

    <table class="govuk-table">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Submission identifier</th>
          <th scope="col" class="govuk-table__header">Outcome</th>
          <th scope="col" class="govuk-table__header">Jira ticket</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for result in results %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a class="govuk-link" href="/submissions/{{ result.submissionId }}">
                {{ result.submissionId }}
              </a>
            </td>
            <td class="govuk-table__cell">
              {% if result.outcome == "scored" %}
                <strong class="govuk-tag govuk-tag--green">
                  Scored{% if result.kindLabel %} — {{ result.kindLabel }}{% endif %}
                </strong>
              {% elif result.outcome == "in-flight" %}
                <strong class="govuk-tag govuk-tag--blue">Already in progress</strong>
              {% elif result.outcome == "timed-out" %}
                <strong class="govuk-tag govuk-tag--orange">Timed out — try again</strong>
              {% else %}
                <strong class="govuk-tag govuk-tag--red">Failed</strong>
              {% endif %}
            </td>
            <td class="govuk-table__cell">
              {% if result.jiraLink %}
                <a class="govuk-link" href="{{ result.jiraLink.url }}" target="_blank" rel="noopener noreferrer">
                  Create Jira ticket<span class="govuk-visually-hidden"> for {{ result.submissionId }} (opens in new tab)</span>
                </a>
                {% if result.jiraLink.truncated %}
                  <p class="govuk-body-s">Description shortened — see full record.</p>
                {% endif %}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <p class="govuk-body">
      <a class="govuk-link" href="/submissions">Back to submissions waiting</a>
    </p>
  </div>
{% endblock %}
