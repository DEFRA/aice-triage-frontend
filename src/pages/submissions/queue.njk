{% extends "common/layout.njk" %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageTitle = "Submissions waiting" %}
{% set page = "submissions" %}

{% block content %}
  <div class="govuk-!-margin-top-6">
    {% if noSelectionError %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [
          {
            text: "Select at least one submission to triage",
            href: "#select-all-submissions"
          }
        ]
      }) }}
    {% endif %}

    <h1 class="govuk-heading-l">Submissions waiting</h1>

    {% if serviceUnavailable %}
      <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          <span class="govuk-visually-hidden">Warning</span>
          the triage service is unavailable
        </strong>
      </div>
    {% elif rows | length == 0 %}
      <p class="govuk-body">No submissions waiting</p>
    {% else %}
      <form id="bulk-triage-form" method="post" action="/submissions/bulk-triage"></form>

      <table class="govuk-table">
        <caption class="govuk-table__caption govuk-visually-hidden">Submissions waiting to be triaged</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">
              <div class="govuk-checkboxes govuk-checkboxes--small">
                <div class="govuk-checkboxes__item">
                  <input
                    class="govuk-checkboxes__input"
                    type="checkbox"
                    id="select-all-submissions"
                    data-select-all="submissionIds"
                  />
                  <label class="govuk-label govuk-checkboxes__label" for="select-all-submissions">
                    <span class="govuk-visually-hidden">Select all submissions</span>
                  </label>
                </div>
              </div>
            </th>
            <th scope="col" class="govuk-table__header">Submission identifier</th>
            <th scope="col" class="govuk-table__header">Received date</th>
            <th scope="col" class="govuk-table__header">Preview</th>
            <th scope="col" class="govuk-table__header">
              <span class="govuk-visually-hidden">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for row in rows %}
            {% set oneLinePreview = (row.textPreviewSource or "") | replace("\n", " ") | trim %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">
                <div class="govuk-checkboxes govuk-checkboxes--small">
                  <div class="govuk-checkboxes__item">
                    <input
                      class="govuk-checkboxes__input"
                      type="checkbox"
                      id="select-{{ row.submissionId }}"
                      name="submissionIds"
                      value="{{ row.submissionId }}"
                      form="bulk-triage-form"
                    />
                    <label class="govuk-label govuk-checkboxes__label" for="select-{{ row.submissionId }}">
                      <span class="govuk-visually-hidden">Select submission {{ row.submissionId }}</span>
                    </label>
                  </div>
                </div>
              </td>
              <td class="govuk-table__cell">
                <a class="govuk-link" href="/submissions/{{ row.submissionId }}">
                  {{ row.submissionId }}
                </a>
              </td>
              <td class="govuk-table__cell">
                <time datetime="{{ row.receivedAtIso }}" title="{{ row.receivedAtIso }}">
                  {{ row.receivedAtDisplay }}
                </time>
              </td>
              <td class="govuk-table__cell">
                {{ oneLinePreview | truncate(140, true, "") }}{% if oneLinePreview | length > 140 %}...{% endif %}
              </td>
              <td class="govuk-table__cell">
                <form method="post" action="/submissions/{{ row.submissionId }}/score">
                  <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" data-prevent-double-click="true">
                    Triage<span class="govuk-visually-hidden"> submission {{ row.submissionId }}</span>
                  </button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <button type="submit" form="bulk-triage-form" class="govuk-button govuk-!-margin-top-4" data-module="govuk-button" data-prevent-double-click="true">
        Bulk triage submissions
      </button>
    {% endif %}
  </div>
{% endblock %}
